{
  "bin": "scripts/diagnose/index.js",
  "scripts": {
    "diagnose": "node scripts/diagnose/index.js",
    "diagnose:deep": "node scripts/diagnose/index.js --deep",
    "build:exe": "pkg scripts/diagnose/index.js --targets node18-win-x64 --output wolf-diagnose.exe",
    "qa:route-manifest": "node scripts/qa/build-route-manifest.js",
    "qa:500-hunter": "node scripts/qa/500-hunter.js",
    "qa:500-hunter:demo": "node scripts/qa/500-hunter.js --profile demo",
    "qa:audit-interaction": "node scripts/qa/audit-dead-buttons-and-kpis.js",
    "qa:pre-demo": "npm --prefix server run demo:seed && node scripts/qa/500-hunter.js --profile demo && npm --prefix client run test:e2e"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "pdfkit": "^0.17.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "madge": "^8.0.0",
    "ora": "^9.1.0",
    "pkg": "^5.8.1",
    "shelljs": "^0.10.0"
  }
}
