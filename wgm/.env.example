# Wolf Guard Mobile (WGM) — Environment Configuration Template
# Copy this to .env and configure for local or VPS development

# ===========================================
# BACKEND API & WEBSOCKET TARGET
# ===========================================
# Production VPS:
EXPO_PUBLIC_API_URL=http://185.213.27.158/wolf/api
EXPO_PUBLIC_SOCKET_URL=http://185.213.27.158

# Local Android Emulator (10.0.2.2 points to host machine):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
# EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:5000

# Local Physical Device (Replace with local Wi-Fi IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.100:5000

# ===========================================
# TENANCY & CLIENT CONFIG
# ===========================================
EXPO_PUBLIC_HOSPITAL_ID=1
EXPO_PUBLIC_CLIENT_TYPE=mobile
